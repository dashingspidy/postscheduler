<div class="page">
  <header class="page-header"><div><p class="eyebrow">Automation</p><h1 class="page-title">Slideshows</h1><p class="page-subtitle">Track CSV-driven TikTok slideshow rendering jobs.</p></div><div class="header-actions"><%= link_to "New slideshow", new_slideshow_import_path, class: "btn btn-primary" %></div></header>
  <% if @slideshow_imports.any? %><div class="card list section"><% @slideshow_imports.each do |import| %><%= link_to import, class: "list-row" do %><div><h2 class="list-title"><%= import.project.name %> · <%= import.status.capitalize %> · <%= import.total_rows %> rows</h2><p class="list-meta"><%= import.completed_rows %> ready, <%= import.failed_rows %> failed · <%= import.tiktok_draft? ? "TikTok draft" : "auto publish" %></p></div><% end %><% end %></div><% else %><div class="card empty-state section"><h2 class="list-title">No slideshows yet</h2><p class="list-meta">Upload a CSV and project images to start generating TikTok slideshows.</p><br><%= link_to "New slideshow", new_slideshow_import_path, class: "btn btn-primary" %></div><% end %>
</div>
