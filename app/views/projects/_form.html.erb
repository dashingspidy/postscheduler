<%= form_with model: project, class: "card bg-base-100 shadow-sm form-card form-stack" do |form| %>
  <% if project.errors.any? %><div class="alert alert-error"><%= project.errors.full_messages.to_sentence %></div><% end %>
  <div class="field"><%= form.label :name, class: "field-label" %><%= form.text_field :name, required: true, class: "input", placeholder: "Education, Muslim app, or another brand" %></div>
  <div class="field"><%= form.label :publishing_provider, "Publishing provider", class: "field-label" %><%= form.select :publishing_provider, Publishing::Registry.options, {}, class: "select" %><p class="field-hint">This project’s posts use this provider. More provider adapters can be added without changing content workflows.</p></div>
  <div class="field"><%= form.label :app_icon, "App icon", class: "field-label" %><%= form.file_field :app_icon, accept: "image/png,image/jpeg", class: "file-input" %><p class="field-hint">A square icon used elsewhere in the app.</p></div>
  <div class="field"><%= form.label :end_slide_branding, "End-slide branding image", class: "field-label" %><%= form.file_field :end_slide_branding, accept: "image/png,image/jpeg", class: "file-input" %><p class="field-hint">A wide image shown only at the bottom of the last slideshow slide.</p></div>
  <% unless project.persisted? %><fieldset class="fieldset"><legend class="fieldset-label">Publishing accounts</legend><p class="field-hint">Choose accounts for the selected provider. Their provider account IDs are saved for future publishing.</p><% if @provider_accounts_error %><div class="alert alert-error"><%= @provider_accounts_error %></div><% elsif @provider_accounts.values.flatten.any? %><div class="form-stack"><% @provider_accounts.each do |provider, accounts| %><% accounts.each do |account| %><label class="checkbox-row"><%= check_box_tag "zernio_account_ids[]", account._id, @selected_zernio_account_ids&.include?(account._id) %><span><strong><%= account.display_name %></strong> · <%= account.platform.capitalize %> · <%= provider.humanize %><% unless account.is_active && account.enabled != false %> (inactive)<% end %></span></label><% end %><% end %></div><% else %><p class="field-hint">No supported social accounts were returned by the configured providers.</p><% end %></fieldset><% end %>
  <fieldset class="fieldset factory-fieldset">
    <legend class="fieldset-label">Daily content factory</legend>
    <p class="field-hint">This enables daily account factories. Configure each TikTok account’s audience and content mix from its Profile button.</p>
    <label class="checkbox-row"><%= form.check_box :factory_enabled %><span>Enable daily automated content</span></label>
    <div class="factory-settings-grid">
      <div class="field factory-timezone"><%= form.label :time_zone, "Project timezone", class: "field-label" %><%= form.select :time_zone, ActiveSupport::TimeZone.all.map { |zone| ["#{zone.name} (#{zone.tzinfo.name})", zone.tzinfo.name] }, {}, class: "select" %></div>
      <div class="field"><%= form.label :factory_time, "Daily post time", class: "field-label" %><%= form.time_field :factory_time, class: "input" %></div>
      <div class="field"><%= form.label :default_slide_count, "Slides per post", class: "field-label" %><%= form.select :default_slide_count, (3..10).map { |count| [count, count] }, {}, class: "select" %></div>
    </div>
  </fieldset>
  <fieldset class="fieldset"><legend class="fieldset-label">Rendering style</legend><div class="form-grid"><%= form.fields_for :style, project.rendering_style do |style| %><div class="field"><%= style.label :font_size, class: "field-label" %><%= style.number_field :font_size, class: "input" %></div><div class="field"><%= style.label :text_color, class: "field-label" %><%= style.text_field :text_color, class: "input" %></div><div class="field"><%= style.label :stroke_color, class: "field-label" %><%= style.text_field :stroke_color, class: "input" %></div><% end %></div></fieldset>
  <div class="form-actions"><%= form.submit class: "btn btn-primary" %><%= link_to "Cancel", projects_path, class: "btn btn-secondary" %></div>
<% end %>
