<div class="page">
  <header class="page-header"><div><p class="eyebrow">Video automation</p><h1 class="page-title">Video creations</h1><p class="page-subtitle">Append a project-branded end card to existing vertical videos.</p></div><div class="header-actions"><%= link_to "New video", new_video_creation_path, class: "btn btn-primary" %></div></header>
  <% if @video_creations.any? %><div class="card bg-base-100 shadow-sm list section"><% @video_creations.each do |creation| %><%= link_to creation, class: "list-row" do %><div><h2 class="list-title"><%= creation.project.name %></h2><p class="list-meta"><%= creation.call_to_action %> · <%= l(creation.created_at, format: :short) %></p></div><span class="status"><%= creation.status %></span><% end %><% end %></div><% else %><div class="card bg-base-100 shadow-sm empty-state section"><h2 class="list-title">Create your first branded video</h2><p class="list-meta">Upload an MP4 and we’ll append your project app icon and call to action.</p><br><%= link_to "New video", new_video_creation_path, class: "btn btn-primary" %></div><% end %>
</div>
