<div class="page">
  <header class="page-header"><div><p class="eyebrow">Video automation</p><h1 class="page-title">Video creations</h1><p class="page-subtitle">Append a project-branded end card to existing vertical videos.</p></div><div class="header-actions"><%= link_to "New video", new_video_creation_path, class: "btn btn-primary" %></div></header>
  <% if @video_creations.any? %><ul class="list w-full max-w-xs rounded-box bg-base-100 shadow-sm section"><% @video_creations.each do |creation| %><li><%= link_to creation, class: "list-row !p-3" do %><div class="list-col-grow min-w-0"><h2 class="truncate text-sm font-semibold"><%= creation.project.name %></h2><p class="truncate text-xs text-base-content/60"><%= creation.call_to_action %></p><p class="text-xs text-base-content/60"><%= l(creation.created_at, format: :short) %></p></div><span class="badge badge-sm badge-ghost"><%= creation.status %></span><% end %></li><% end %></ul><% else %><div class="card bg-base-100 shadow-sm empty-state section"><h2 class="list-title">Create your first branded video</h2><p class="list-meta">Upload an MP4 and we’ll append your project app icon and call to action.</p><br><%= link_to "New video", new_video_creation_path, class: "btn btn-primary" %></div><% end %>
</div>
