<div class="page page-narrow">
  <header class="page-header"><div><p class="eyebrow">Video automation</p><h1 class="page-title">Create branded video</h1><p class="page-subtitle">Upload an existing MP4. A two-second end card with your project icon and message will be appended in the background.</p></div></header>
  <%= form_with model: @video_creation, class: "card bg-base-100 shadow-sm form-card form-stack" do |form| %>
    <% if @video_creation.errors.any? || @post.errors.any? %><div class="alert alert-error"><%= (@video_creation.errors.full_messages + @post.errors.full_messages).to_sentence %></div><% end %>
    <div class="field"><%= form.label :project_id, "Project", class: "field-label" %><%= form.collection_select :project_id, @projects, :id, :name, { prompt: "Choose a project" }, required: true, class: "select" %><p class="field-hint">The selected project must have an app icon for the end card.</p></div>
    <div class="field"><%= form.label :title, "Post title", class: "field-label" %><%= form.text_field :title, required: true, class: "input", placeholder: "Optional public title" %></div>
    <div class="field"><%= form.label :content, "Caption", class: "field-label" %><%= form.text_area :content, required: true, class: "textarea", placeholder: "Write the caption for this video post" %></div>
    <div class="field"><%= form.label :input_video, "Source video", class: "field-label" %><%= form.file_field :input_video, accept: "video/mp4", required: true, class: "file-input" %><p class="field-hint">The video is normalized to a 1080 × 1920 MP4 before the end card is added.</p></div>
    <div class="field"><%= form.label :call_to_action, "End-card message", class: "field-label" %><%= form.text_field :call_to_action, required: true, class: "input", placeholder: "Download the app" %></div>
    <fieldset class="fieldset"><legend class="fieldset-label">Publishing accounts</legend><p class="field-hint">Select TikTok video, Instagram Reel, Facebook Reel, and/or YouTube Short destinations from the selected project.</p><% selected_ids = @selected_zernio_account_ids || [] %><div class="form-stack"><% @zernio_accounts.each do |account| %><label class="checkbox-row"><%= check_box_tag "video_creation[zernio_account_ids][]", account.id, selected_ids.include?(account.id.to_s) %><span><strong><%= account.label %></strong> · <%= account.platform.capitalize %> · <%= account.project.name %></span></label><% end %></div><% if @zernio_accounts.empty? %><p class="field-hint">No active Zernio accounts are linked to your projects yet.</p><% end %></fieldset>
    <div class="form-actions"><%= form.submit "Create video", class: "btn btn-primary" %><%= link_to "Cancel", video_creations_path, class: "btn btn-secondary" %></div>
  <% end %>
</div>
