<% if @video_creation.processing? || @video_creation.pending? %><meta http-equiv="refresh" content="4"><% end %>
<div class="page page-narrow">
  <header class="page-header"><div><p class="eyebrow">Video creation</p><h1 class="page-title"><%= @video_creation.project.name %></h1><p class="page-subtitle"><%= @video_creation.status.capitalize %><%= " · refreshes automatically" if @video_creation.processing? || @video_creation.pending? %></p></div><div class="header-actions"><%= link_to "All videos", video_creations_path, class: "btn btn-secondary" %><%= link_to "New video", new_video_creation_path, class: "btn btn-primary" %></div></header>
  <section class="card bg-base-100 shadow-sm pipeline section"><div class="pipeline-stages"><div class="pipeline-stage pipeline-stage-complete"><span class="pipeline-marker">1</span><div><p class="pipeline-stage-title">Video uploaded</p><p class="pipeline-stage-copy">Source MP4 saved</p></div></div><div class="pipeline-stage <%= @video_creation.processing? ? "pipeline-stage-active" : (@video_creation.completed? ? "pipeline-stage-complete" : (@video_creation.failed? ? "pipeline-stage-failed" : "") ) %>"><span class="pipeline-marker">2</span><div><p class="pipeline-stage-title">End card rendered</p><p class="pipeline-stage-copy">Project icon and message added</p></div></div><div class="pipeline-stage <%= @video_creation.completed? ? "pipeline-stage-complete" : "" %>"><span class="pipeline-marker">3</span><div><p class="pipeline-stage-title">Video ready</p><p class="pipeline-stage-copy">Ready for review and publishing</p></div></div></div></section>
  <% if @video_creation.error_message.present? %><p class="alert alert-error section"><strong>Video creation failed:</strong> <%= @video_creation.error_message %></p><% end %>
  <% if @video_creation.output_video.attached? %><section class="card bg-base-100 shadow-sm card-body section"><p class="eyebrow">Generated video</p><video controls class="video-preview"><%= tag.source src: url_for(@video_creation.output_video), type: "video/mp4" %></video><div class="form-actions"><%= link_to "Review post", @video_creation.post, class: "btn btn-primary" if @video_creation.post %><%= link_to "Open video", url_for(@video_creation.output_video), class: "btn btn-secondary", target: "_blank", rel: "noopener" %></div></section><% end %>
</div>
