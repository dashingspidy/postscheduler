<div class="page page-narrow"><header class="page-header"><div><p class="eyebrow">Post</p><h1 class="page-title"><%= @post.title.presence || "Post" %></h1></div><%= link_to "Edit post", edit_post_path(@post), class: "btn btn-secondary" %></header><section class="card card-body bg-base-100 shadow-sm section"><p class="post-content"><%= @post.content %></p><% if @post.video.attached? %><video controls class="video-preview section"><%= tag.source src: url_for(@post.video), type: "video/mp4" %></video><% elsif @post.slides.attached? %><div class="preview-grid section"><% @post.slides.each do |slide| %><%= image_tag slide, class: "preview-image" %><% end %></div><% end %><dl class="section"><div><dt class="field-label">Content type</dt><dd><%= @post.video.attached? ? "Video" : "Slideshow" %></dd></div><div class="section"><dt class="field-label">Status</dt><dd><%= @post.status.capitalize %></dd></div><div class="section"><dt class="field-label">Publish at</dt><dd><%= @post.scheduled_at ? l(@post.scheduled_at, format: :long) : "Draft" %></dd></div><div class="section"><dt class="field-label">Platforms</dt><dd><%= @post.platforms.map(&:capitalize).to_sentence %></dd></div></dl></section><div class="form-actions section"><%= link_to "All posts", posts_path, class: "btn btn-secondary" %><%= button_to "Delete", @post, method: :delete, class: "btn btn-error btn-outline", form: { data: { turbo_confirm: "Delete this post?" } } %></div></div>
