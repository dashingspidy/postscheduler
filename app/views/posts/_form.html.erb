<%= form_with model: post, class: "card bg-base-100 shadow-sm form-card form-stack" do |form| %>
  <% if post.errors.any? %><div class="alert alert-error"><%= post.errors.full_messages.to_sentence %></div><% end %>
  <div class="field"><%= form.label :title, class: "field-label" %><%= form.text_field :title, class: "input", placeholder: "Optional internal title" %></div>
  <div class="field"><%= form.label :content, "Caption", class: "field-label" %><%= form.text_area :content, rows: 6, required: true, class: "textarea" %></div>
  <div class="field"><%= form.label :scheduled_at, "Publish at", class: "field-label" %><%= form.datetime_local_field :scheduled_at, class: "input" %><p class="field-hint">Leave blank to keep this as a draft.</p></div>
  <div class="field"><%= form.label :project_id, "Project", class: "field-label" %><%= form.collection_select :project_id, @projects, :id, :name, { prompt: "Choose a project" }, required: true, class: "select" %></div>
  <fieldset class="fieldset"><legend class="fieldset-label">Publishing accounts</legend><p class="field-hint">Select accounts that belong to the chosen project. Their Zernio IDs are filled in automatically.</p><% selected_ids = @selected_zernio_account_ids || @zernio_accounts.select { |account| Array(post.account_ids[account.platform]).include?(account.account_id) }.map(&:id).map(&:to_s) %><div class="form-stack"><% @zernio_accounts.each do |account| %><label class="checkbox-row"><%= check_box_tag "post[zernio_account_ids][]", account.id, selected_ids.include?(account.id.to_s) %><span><strong><%= account.label %></strong> · <%= account.platform.capitalize %> · <%= account.project.name %></span></label><% end %></div><% if @zernio_accounts.empty? %><p class="field-hint">No active Zernio accounts are linked to your projects yet.</p><% end %></fieldset>
  <div class="form-actions"><%= form.submit class: "btn btn-primary" %><%= link_to "Cancel", post.persisted? ? post : posts_path, class: "btn btn-secondary" %></div>
<% end %>
